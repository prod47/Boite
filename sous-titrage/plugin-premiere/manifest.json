{
  "manifestVersion": 5,
  "id": "com.haussmannprod.soustitrage",
  "name": "Sous-titrage Happy Scribe",
  "version": "0.3.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.5.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "soustitrage",
      "label": { "default": "Sous-titrage Happy Scribe" },
      "minimumSize": { "width": 280, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 480 },
      "preferredFloatingSize": { "width": 380, "height": 520 }
    }
  ]
}
